<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site configuration: forwards every request to the Node.js app on http://127.0.0.1:3000.
  Requires the IIS "URL Rewrite" and "Application Request Routing (ARR)" modules,
  with proxy enabled in ARR (see docs/DEPLOY-IIS.md).
  Put this file in the folder the IIS site points to.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Node.js" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 100 MB: documents with screenshots are sent in one request -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
