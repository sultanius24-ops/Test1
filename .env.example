# Copy this file to ".env" and fill in the values.  NEVER commit .env to git.

# ---- Server ----
NODE_ENV=production
PORT=3000
# Node only listens locally; IIS forwards requests to it.
HOST=127.0.0.1
# Public address users open in the browser (must be https in production).
BASE_URL=https://docs.utas.edu.om
# Long random string (at least 32 characters). Changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Sign-in lifetime while idle, in hours.
SESSION_HOURS=8

# ---- Database ----
DB_PATH=data/utas-docs.db
BACKUP_DIR=backups
BACKUP_KEEP=30

# ---- Microsoft 365 sign-in (Entra ID app registration) ----
AUTH_MODE=microsoft
# "Directory (tenant) ID" from the app registration overview page
MS_TENANT_ID=
# "Application (client) ID"
MS_CLIENT_ID=
# Client secret VALUE (Certificates & secrets). Note its expiry date!
MS_CLIENT_SECRET=

# ---- Access ----
# These people become admins when they sign in (comma separated).
ADMIN_EMAILS=
# Optional: only allow these email domains (comma separated), e.g. utas.edu.om
ALLOWED_EMAIL_DOMAINS=utas.edu.om
# Role for new people after their first sign-in:
#   pending = an admin must approve them (recommended)
#   member  = everyone in the university can use it immediately
NEW_USER_ROLE=pending

# Maximum size of one save request in MB (attachments are included in the document).
MAX_REQUEST_MB=60
